{
  "name": "dsh-authless",
  "version": "0.1.1",
  "description": "Serve the local DSH Web UI without the launch-token gate; the Host/Origin fence stays.",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "dsh-bundle",
    "web",
    "auth",
    "token",
    "local-development"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zerodegress/dsh-authless.git"
  },
  "homepage": "https://github.com/zerodegress/dsh-authless#readme",
  "bugs": {
    "url": "https://github.com/zerodegress/dsh-authless/issues"
  },
  "author": "zerodegress",
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js"
  },
  "files": [
    "src/index.js",
    "cordis.patch.yml",
    "dsh-plugin.json",
    "README.md",
    "README_ZH.md",
    "LICENSE",
    "docs/design.md",
    "docs/design_ZH.md",
    "CHANGELOG.md"
  ],
  "license": "MIT",
  "engines": {
    "dsh": ">=0.2.1-rc.2 <0.3.0",
    "node": "^22.19 || >=24"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "test": "node scripts/verify.mjs",
    "prepublishOnly": "npm test"
  },
  "publishConfig": {
    "access": "public"
  }
